# Q-MedTriage Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: openai, anthropic, or other
LLM_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.3

# Anthropic Configuration (if using Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ============================================================================
# RAG CONFIGURATION
# ============================================================================

# Embedding model (from sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of documents to retrieve
RAG_TOP_K=5

# Vector database path
VECTOR_DB_PATH=data/knowledge/vector_index

# Knowledge corpus path
KNOWLEDGE_CORPUS_PATH=data/knowledge/medical_corpus.json

# ============================================================================
# API CONFIGURATION
# ============================================================================

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================================================
# SAFETY CONFIGURATION
# ============================================================================

# Enable/disable intelligence layer
INTELLIGENCE_ENABLED=true

# Fallback mode if intelligence layer fails
FALLBACK_TO_PREDICTION_ONLY=true
